# Jira Cloud API
JIRA_BASE_URL=https://my-jira.atlassian.net
JIRA_EMAIL=your.email@example.com
JIRA_API_TOKEN=replace-with-api-token
JIRA_JQL='project = "My project" AND worklogDate >= "2026-05-01" AND worklogDate < "2026-06-01"'
JIRA_TIMEZONE=Europe/Warsaw

# Optional defaults for API report runs.
# JIRA_FROM=2026-05-01
# JIRA_TO=2026-06-01
# JIRA_OUTPUT=raports/jira_api_grouped.csv
